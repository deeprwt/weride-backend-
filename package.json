{
  "name": "@uride/api",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "WeRide core API \u2014 NestJS modular monolith. REST + WS gateway. Stateless, horizontally scalable.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "build:standalone": "npm run build:libs && npm run build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --testPathPattern \"test/\" --passWithNoTests",
    "clean": "rimraf dist .turbo coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.ts",
    "build:libs": "npm run build -w packages/types && npm run build -w packages/validation",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.1",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^8.47.0",
    "@uride/types": "*",
    "@uride/validation": "*",
    "bullmq": "^5.34.0",
    "h3-js": "^4.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.3.0",
    "nestjs-throttler-storage-redis": "^0.5.1",
    "nodemailer": "^6.9.16",
    "opossum": "^8.4.0",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.6",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/opossum": "^8.1.8",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@uride/config": "*",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
