{
  "name": "@uride/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types across the WeRide monorepo. Domain primitives only — runtime schemas live in @uride/validation.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo 'types: no tests'",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@uride/config": "*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
