# ============================================================================
# WeRide core API — environment variables
#
# COPY THIS FILE TO .env AND FILL IN THE VALUES.
# .env is gitignored. Never commit secrets.
#
# Local dev defaults assume `pnpm docker:up` from the repo root and require
# zero external accounts (no Supabase, no Twilio).
#
# To switch to production providers later: flip AUTH_PROVIDER + OTP_PROVIDER
# and provide the corresponding credentials. No code changes required.
# ============================================================================

# --- Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug                  # trace|debug|info|warn|error|fatal
LOG_PRETTY=true                  # set false in prod

# --- Database (Postgres + PostGIS)
# Local docker-compose:
DATABASE_URL=postgresql://uride:uride@localhost:55432/uride?schema=public
DIRECT_URL=postgresql://uride:uride@localhost:55432/uride?schema=public
# Supabase (uncomment when provisioning):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# --- Redis
REDIS_URL=redis://localhost:56379

# ============================================================================
# IDENTITY PROVIDER
# ============================================================================
AUTH_PROVIDER=local              # local | supabase

# Required in local mode. MUST be ≥32 chars. The API refuses to boot if this
# value matches the placeholder below — generate your own:
#   openssl rand -base64 48
JWT_LOCAL_SECRET=PLACEHOLDER_DO_NOT_USE_GENERATE_WITH_openssl_rand_base64_48

JWT_ISSUER=uride-local
JWT_ACCESS_TTL_SECONDS=900               # 15 min
JWT_REFRESH_TTL_MOBILE_SECONDS=1209600   # 14 days
JWT_REFRESH_TTL_ADMIN_SECONDS=28800      # 8 hours

# --- Supabase (required when AUTH_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ============================================================================
# OTP PROVIDER
# ============================================================================
OTP_PROVIDER=local               # local | twilio
OTP_TTL_SECONDS=300              # 5 min
OTP_RATE_PER_PHONE_PER_MIN=5
OTP_RATE_PER_IP_PER_HOUR=20

# Local-dev convenience: when set, ALSO accepts this code for any phone.
# The API REFUSES to boot if this is set AND any of:
#   - NODE_ENV=production
#   - AUTH_PROVIDER=supabase
#   - OTP_PROVIDER=twilio
# Defaults unset. Set to 123456 for E2E tests.
LOCAL_DEV_MAGIC_OTP=

# Local OTP "SMS" preview via Mailhog (browse at http://localhost:8025)
MAILHOG_SMTP_HOST=localhost
MAILHOG_SMTP_PORT=1025
LOCAL_OTP_PREVIEW_EMAIL=dev-otp-preview@uride.local

# --- Twilio (required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ============================================================================
# ADMIN AUTH (email + password + TOTP)
# ============================================================================
ADMIN_MIN_PASSWORD_LENGTH=12
HIBP_ENABLED=true                # set false to skip pwned-password check
TOTP_ISSUER=WeRide
TOTP_RECOVERY_CODE_COUNT=10

# ============================================================================
# Pricing service (FastAPI sibling)
# ============================================================================
PRICING_BASE_URL=http://localhost:5000
PRICING_TIMEOUT_MS=2000

# ============================================================================
# DRIVER ONBOARDING + DISPATCH (Phase 2)
# ============================================================================
# Where KYC uploads (licence, insurance, registration, profile photo) land.
# 'local' writes plain files under DOCUMENT_STORAGE_PATH — free, works offline.
# The API REFUSES to boot on 's3': the driver exists in the config enum but has
# no implementation yet, and a half-wired bucket would swallow KYC uploads.
DOCUMENT_STORAGE_DRIVER=local    # local | s3 (s3 not implemented yet)

# Resolved relative to backend/. Gitignored — the API creates it on first write.
DOCUMENT_STORAGE_PATH=./var/documents

# A driver whose last ping is older than this is invisible to dispatch.
DRIVER_LOCATION_STALE_SECONDS=60         # 1 min

# Hard ceiling on the nearby-driver search radius, whatever a request asks for.
DRIVER_MAX_SEARCH_RADIUS_METERS=25000    # 25 km

# Drivers must re-confirm they are online at least this often; the sweeper
# marks anyone quieter than this offline so they stop receiving offers.
DRIVER_ONLINE_HEARTBEAT_SECONDS=120      # 2 min

# H3 hexagon rings each dispatch wave searches around the pickup, widening per
# round (1,2,3 = 7, 19, 37 cells of ~0.5 km-edge hexagons). Must increase; the
# last entry repeats for any extra rounds. DISPATCH_RADIUS_LADDER_METERS (default
# 3000,6000,10000) still caps how far away an offered driver may be each round.
# Redis reads only — nothing billable.
DISPATCH_RING_LADDER=1,2,3

# ============================================================================
# GEO HOT PATH — live driver index + batched location trail
# ============================================================================
# A location ping writes Redis and returns. The driver's live position goes into
# the H3 hexagon index (what dispatch, surge and live ETA read); the point joins
# a Redis queue that LocationFlushWorker drains into Postgres in bulk. No new
# provider and nothing billable — this is Redis and Postgres you already run.

# How often the flush worker drains the queue. Drain rate is
# GEO_FLUSH_BATCH_SIZE / (GEO_FLUSH_TICK_MS / 1000) points per second, and it
# must stay above (online drivers / ping interval) or the backlog only grows.
GEO_FLUSH_TICK_MS=1000                   # 1 s

# Points read per tick. Max 4000: the trail INSERT binds 8 parameters a row and
# Postgres refuses a statement past 65,535 of them.
GEO_FLUSH_BATCH_SIZE=2000

# Queue ceiling while Postgres cannot take writes. Past it the OLDEST points are
# dropped, loudly, so a long database outage cannot run Redis (which also holds
# sessions, rate limits and dispatch locks) out of memory. ~250 bytes a point.
GEO_FLUSH_QUEUE_MAX_POINTS=500000        # ~125 MB

# Points with no ride keep at most one per driver per this many seconds. Points
# recorded on a ride are ALWAYS kept — they are fare-dispute evidence.
GEO_IDLE_TRAIL_SAMPLE_SECONDS=30

# driver_availability.last_location / last_ping_at refresh at most this often per
# driver (the admin dashboard and heartbeat sweeper read them; dispatch does not).
# The API refuses to boot unless 2x this plus one flush tick fits inside
# DRIVER_ONLINE_HEARTBEAT_SECONDS — otherwise pinging drivers get swept offline.
GEO_AVAILABILITY_REFRESH_SECONDS=15

# ============================================================================
# Phase 3+ external providers
# ============================================================================
# Maps / Routes. 'none' is the free local-dev path: no key, no calls, no bill.
# 'google' is the platform's FIRST BILLABLE dependency ($200/mo free credit,
# then roughly $3–5k/mo at 100k DAU) — read docs/RUNBOOK.md §4 before flipping
# it. Boot fails if this is 'google' and GOOGLE_MAPS_API_KEY is missing.
MAPS_PROVIDER=none               # none | google

# Required once MAPS_PROVIDER=google. The API refuses to boot if the real key
# still matches the placeholder below, exactly as it does for JWT_LOCAL_SECRET.
# Get one at https://console.cloud.google.com/google/maps-apis — restrict it.
GOOGLE_MAPS_API_KEY=PLACEHOLDER_NOT_A_REAL_KEY_REPLACE_BEFORE_SETTING_MAPS_PROVIDER_google

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# Observability
# ============================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=uride-api

# ============================================================================
# Security
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
